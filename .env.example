# LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
LLM_MODEL=qwen/qwen3.6-plus:free
LLM_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_BASE_MS=1500
# Optional comma-separated fallback models, tried in order after LLM_MODEL
# LLM_FALLBACK_MODELS=deepseek/deepseek-r1:free,meta-llama/llama-3.3-70b-instruct:free

# Sources
TAVILY_API_KEY=your_tavily_api_key
GOOGLE_API_KEY=your_google_api_key
ENSEMBLE_DATA_API_KEY=your_ensembledata_api_key

# Map
MAPBOX_API_KEY=your_mapbox_token
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# Pipeline
SOURCE_TIMEOUT_MS=10000
MAX_PIPELINE_TIME_MS=300000

# Trip brief persistence
DATABASE_URL=postgres://user:password@localhost:5432/scenic_travel_route
TRIP_BRIEF_TOKEN_SECRET=replace_with_secure_random_secret
